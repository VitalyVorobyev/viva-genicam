{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viva Studio",
  "identifier": "com.vitalyvorobyev.viva-studio",
  "build": {
    "beforeDevCommand": "bun run --cwd ../../ui/viva-studio-ui dev:tauri",
    "beforeBuildCommand": "bun run --cwd ../../ui/viva-studio-ui build:tauri",
    "devUrl": "http://localhost:5183",
    "frontendDist": "../../../ui/viva-studio-ui/dist"
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "appimage",
      "deb",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/sfnc-groups.json"
    ],
    "shortDescription": "Reference viewer for GenICam cameras",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Viva Studio",
        "width": 1024,
        "height": 768
      }
    ]
  }
}
